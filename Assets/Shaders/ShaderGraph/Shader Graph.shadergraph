{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "281d32fd47df48de99fba0da54d21106",
    "m_Title": "Custom functions",
    "m_Content": "The Custom Function node is a special node that we can use to create our own function.\n\nWe have two way to create our custom function: we can specify a .hlsl file or we can directly write the function body inside the node.\n\nThe function inputs and output must be defined in the node settings",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -761.0,
        "y": 921.0,
