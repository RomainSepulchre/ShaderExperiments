{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "f7cf8fa412b94eb98f2487b1bb57ca44",
    "m_Title": "Vertex Shader",
    "m_Content": "The Vertex block defines inputs.\n\nBy default 3 inputs are defined: Position, Normal and Tangent. They are the equivalent of appdata input variables binded with the semantics: POSITION[n], NORMAL[n], TANGENT[n].\n\nThe number after the name of the input define the type or the number of dimensions of the input. For example, Position(3) is a 3D vector (XYZ).\n\nAll the inputs are in Object-space like the block on the left shows.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 505.0,
        "y": -67.0,
        "width": 300.0,
        "height": 235.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "f850e810f4dc447898d8adbf2329083c",
    "m_Title": "Property nodes",
    "m_Content": "Dragging a property from the blackboard to the node area is like creating a connection variable. The property node can be used in the shader code.\n\n The number after the name of the property node define the type or the number of dimensions of the property. For example, _MainTex(T2) is a Texture2D and _Color is a 4D vector (RGBA).",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1530.0,
        "y": -83.0,
        "width": 394.0,
        "height": 168.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

