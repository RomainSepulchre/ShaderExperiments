				<variable type="bool" name="showSingleNoise">
					<row>
						<value>false</value>
					</row>
				</variable>
			</variables>
			<macros />
		</pass>
	</pipeline>
	<objects />
	<cameras />
	<settings>
		<entry type="file" name="ValueNoise" shader="vs" />
		<entry type="file" name="ValueNoise" shader="ps" />
		<entry type="pinned" name="cellCount" owner="ValueNoise" />
		<entry type="pinned" name="noiseOctaves" owner="ValueNoise" />
