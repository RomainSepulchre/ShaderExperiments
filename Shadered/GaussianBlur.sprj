<?xml version="1.0"?>
<project version="2">
	<pipeline>
		<pass name="GaussianBlur" type="shader" active="true" patchverts="1">
			<shader type="vs" path="shaders\GaussianBlur_GaussianBlurVS.hlsl" entry="main" />
			<shader type="ps" path="shaders\GaussianBlur_GaussianBlurPS.hlsl" entry="main" />
			<inputlayout>
				<item value="Position" semantic="POSITION" />
				<item value="Normal" semantic="NORMAL" />
				<item value="Texcoord" semantic="TEXCOORD0" />
			</inputlayout>
			<rendertexture />
			<items>
				<item name="Quad" type="geometry">
					<type>ScreenQuadNDC</type>
					<width>1</width>
					<height>1</height>
					<depth>1</depth>
					<topology>TriangleList</topology>
				</item>
			</items>
			<itemvalues />
			<variables>
				<variable type="float2" name="uResolution" system="ViewportSize" />
				<variable type="float" name="uTime" system="Time" />
				<variable type="float4" name="d">
					<row>
						<value>1.39999998</value>
						<value>1</value>
						<value>0</value>
						<value>0</value>
					</row>
				</variable>
				<variable type="bool" name="useGaussian">
					<row>
						<value>false</value>
					</row>
				</variable>
				<variable type="bool" name="useBoxBlur">
					<row>
						<value>false</value>
					</row>
				</variable>
				<variable type="float" name="resolutionDivisor">
					<row>
						<value>2.94000006</value>
					</row>
				</variable>
				<variable type="float" name="uKernelSize">
					<row>
						<value>1</value>
					</row>
				</variable>
			</variables>
			<macros />
		</pass>
	</pipeline>
	<objects>
		<object type="texture" path="Textures\BernardPlenske.jpg" vflip="false" min_filter="Linear" mag_filter="Nearest" wrap_s="Repeat" wrap_t="Repeat">
			<bind slot="0" name="GaussianBlur" />
		</object>
	</objects>
	<cameras />
	<settings>
		<entry type="property" name="GaussianBlur" item="pipe" />
		<entry type="file" name="GaussianBlur" shader="vs" />
		<entry type="file" name="GaussianBlur" shader="ps" />
		<entry type="pinned" name="d" owner="GaussianBlur" />
		<entry type="pinned" name="useGaussian" owner="GaussianBlur" />
		<entry type="pinned" name="useBoxBlur" owner="GaussianBlur" />
		<entry type="pinned" name="uKernelSize" owner="GaussianBlur" />
		<entry type="pinned" name="resolutionDivisor" owner="GaussianBlur" />
		<entry type="camera" fp="false">
			<distance>8</distance>
			<pitch>-83</pitch>
			<yaw>295</yaw>
			<roll>360</roll>
		</entry>
		<entry type="clearcolor" r="0" g="0" b="0" a="1" />
		<entry type="usealpha" val="false" />
	</settings>
	<plugindata />
</project>
