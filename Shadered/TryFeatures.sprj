<?xml version="1.0"?>
<project version="2">
	<pipeline>
		<pass name="Main" type="shader" active="true" patchverts="1" collapsed="true">
			<shader type="vs" path="shaders\TryFeatures_MainVS.hlsl" entry="main" />
			<shader type="ps" path="shaders\TryFeatures_MainPS.hlsl" entry="main" />
			<inputlayout>
				<item value="Position" semantic="POSITION" />
				<item value="Normal" semantic="NORMAL" />
				<item value="Texcoord" semantic="TEXCOORD0" />
			</inputlayout>
			<rendertexture />
			<items>
				<item name="Box" type="geometry">
					<type>Cube</type>
					<width>1</width>
					<height>1</height>
					<depth>1</depth>
					<topology>TriangleList</topology>
				</item>
				<item name="quad" type="geometry">
					<type>ScreenQuadNDC</type>
					<width>1</width>
					<height>1</height>
					<depth>1</depth>
					<topology>TriangleList</topology>
				</item>
			</items>
			<itemvalues />
			<variables>
				<variable type="float4x4" name="matVP" system="ViewProjection" />
				<variable type="float4x4" name="matGeo" system="GeometryTransform" />
				<variable type="float" name="time" system="Time" />
				<variable type="float" name="timeSpeed">
					<row>
						<value>2</value>
					</row>
				</variable>
				<variable type="float2" name="mousePos" system="MousePosition" />
				<variable type="float4" name="varColor">
					<row>
						<value>1</value>
						<value>1</value>
						<value>1</value>
						<value>1</value>
					</row>
				</variable>
			</variables>
			<macros />
		</pass>
	</pipeline>
	<objects>
		<object type="texture" path="..\..\..\..\..\Program Files\SHADERed\icon_256x256.png" vflip="false" min_filter="Linear" mag_filter="Nearest" wrap_s="Repeat" wrap_t="Repeat">
			<bind slot="0" name="Main" />
		</object>
	</objects>
	<cameras />
	<settings>
		<entry type="file" name="Main" shader="vs" />
		<entry type="file" name="Main" shader="ps" />
		<entry type="pinned" name="timeSpeed" owner="Main" />
		<entry type="pinned" name="varColor" owner="Main" />
		<entry type="camera" fp="false">
			<distance>6</distance>
			<pitch>-1</pitch>
			<yaw>182</yaw>
			<roll>360</roll>
		</entry>
		<entry type="clearcolor" r="0" g="0" b="0" a="1" />
		<entry type="usealpha" val="false" />
		<entry type="watch_expr" expr="texCol.rgb" />
		<entry type="watch_expr" expr="pin.Color" />
		<entry type="vecwatch_expr" expr="normalize(pin.Normal)" color_r="0.949806929" color_g="0.726107061" color_b="0" />
		<entry type="vecwatch_expr" expr="pin.Color" color_r="0.788235307" color_g="0.470588237" color_b="0.549019635" />
	</settings>
	<plugindata />
</project>
