<?xml version="1.0"?>
<project version="2">
	<pipeline>
		<pass name="BoxBlur" type="shader" active="true" patchverts="1">
			<shader type="vs" path="shaders\BoxBlur_BoxBlurVS.hlsl" entry="main" />
			<shader type="ps" path="shaders\BoxBlur_BoxBlurPS.hlsl" entry="main" />
			<inputlayout>
				<item value="Position" semantic="POSITION" />
				<item value="Normal" semantic="NORMAL" />
				<item value="Texcoord" semantic="TEXCOORD0" />
			</inputlayout>
			<rendertexture />
			<items>
				<item name="Quad" type="geometry">
					<type>ScreenQuadNDC</type>
					<width>1</width>
					<height>1</height>
					<depth>1</depth>
					<topology>TriangleList</topology>
				</item>
			</items>
			<itemvalues />
			<variables>
				<variable type="float2" name="uResolution" system="ViewportSize" />
				<variable type="float" name="uTime" system="Time" />
				<variable type="int" name="uRange">
					<row>
						<value>4</value>
					</row>
				</variable>
				<variable type="float" name="uJump">
					<row>
						<value>10</value>
					</row>
				</variable>
			</variables>
			<macros />
		</pass>
		<pass name="NoBlur" type="shader" active="true" patchverts="1">
