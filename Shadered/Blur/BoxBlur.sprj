	<objects>
		<object type="texture" path="..\Textures\whiteBox.png" vflip="false" min_filter="Linear" mag_filter="Nearest" wrap_s="Repeat" wrap_t="Repeat">
			<bind slot="0" name="NoBlur" />
		</object>
		<object type="rendertexture" name="RT_NoBlur" fsize="512,512" clear="true">
