<?xml version="1.0"?>
<project version="2">
	<pipeline>
		<pass name="Main" type="shader" active="true" patchverts="1">
			<shader type="vs" path="shaders\Simple2DShader_MainVS.hlsl" entry="main" />
			<shader type="ps" path="shaders\Simple2DShader_MainPS.hlsl" entry="main" />
			<inputlayout>
				<item value="Position" semantic="POSITION" />
				<item value="Normal" semantic="NORMAL" />
				<item value="Texcoord" semantic="TEXCOORD0" />
			</inputlayout>
			<rendertexture />
			<items>
				<item name="screen" type="geometry">
					<type>ScreenQuadNDC</type>
					<width>1</width>
					<height>1</height>
					<depth>1</depth>
					<topology>TriangleList</topology>
				</item>
			</items>
			<itemvalues />
			<variables>
				<variable type="float" name="radius">
					<row>
						<value>0.0500000007</value>
					</row>
				</variable>
				<variable type="float" name="circleSmooth">
					<row>
						<value>0.100000001</value>
					</row>
				</variable>
				<variable type="float2" name="uResolution" system="ViewportSize" />
				<variable type="float" name="uTime" system="Time" />
				<variable type="float2" name="mousePos" system="MousePosition" />
			</variables>
			<macros />
		</pass>
	</pipeline>
	<objects />
	<cameras />
	<settings>
		<entry type="file" name="Main" shader="vs" />
		<entry type="file" name="Main" shader="ps" />
		<entry type="pinned" name="radius" owner="Main" />
		<entry type="pinned" name="circleSmooth" owner="Main" />
		<entry type="camera" fp="false">
			<distance>46</distance>
			<pitch>-34</pitch>
			<yaw>78</yaw>
			<roll>360</roll>
		</entry>
		<entry type="clearcolor" r="0" g="0" b="0" a="0" />
		<entry type="usealpha" val="false" />
		<entry type="watch_expr" expr="mousePos" />
	</settings>
	<plugindata />
</project>
